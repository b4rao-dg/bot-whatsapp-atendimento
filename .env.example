# Copie para .env e preencha com os dados do painel da Meta (WhatsApp > API Setup)
WHATSAPP_TOKEN=cole_o_token_temporario_aqui
PHONE_NUMBER_ID=cole_o_phone_number_id_aqui
# Qualquer texto que você inventar; o mesmo vai no painel da Meta ao configurar o webhook
VERIFY_TOKEN=minha-senha-do-webhook
# Opcional: App Secret (Configurações do app > Básico) para validar a assinatura
APP_SECRET=
GRAPH_API_VERSION=v21.0
PORT=5000
